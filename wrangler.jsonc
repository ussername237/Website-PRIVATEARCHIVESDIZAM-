{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "privatearchivesdizam",
	"main": "./worker/index.js",
	"compatibility_date": "2026-01-01",
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "privatearchivesdizam-auth",
			"database_id": "fc6d05e6-b8e3-4309-9ce1-47ea6614609e",
			"migrations_dir": "migrations"
		}
	]
}